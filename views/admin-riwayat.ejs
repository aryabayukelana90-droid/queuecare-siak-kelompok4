<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head', { title: 'Riwayat Antrean - QueueCare Admin' }) %>
</head>
<body>

<nav class="navbar navbar-dark bg-primary">
    <div class="container">
        <span class="navbar-brand fw-bold">
            <img src="/img/sakura-icon.svg" alt="QueueCare">
            QueueCare — Admin
        </span>

        <div class="d-flex align-items-center gap-2">
            <a href="/admin" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
            <a href="/logout" class="btn btn-light btn-sm">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </div>
    </div>
</nav>

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="mb-0">Riwayat Antrean</h2>
        <a class="btn btn-success btn-sm"
           href="/admin/riwayat/export?tanggal=<%= filter.tanggal %>&status=<%= filter.status %>&poli=<%= filter.poli %>">
            <i class="bi bi-download"></i> Export CSV
        </a>
    </div>

    <form class="card shadow-sm p-3 mb-4" method="GET" action="/admin/riwayat">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label>Tanggal</label>
                <input type="date" name="tanggal" value="<%= filter.tanggal %>" class="form-control">
            </div>
            <div class="col-md-3">
                <label>Status</label>
                <select name="status" class="form-control">
                    <option value="">Semua Status</option>
                    <option value="Menunggu" <%= filter.status === 'Menunggu' ? 'selected' : '' %>>Menunggu</option>
                    <option value="Dipanggil" <%= filter.status === 'Dipanggil' ? 'selected' : '' %>>Dipanggil</option>
                    <option value="Selesai" <%= filter.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
                    <option value="Dilewati" <%= filter.status === 'Dilewati' ? 'selected' : '' %>>Dilewati</option>
                    <option value="Dibatalkan" <%= filter.status === 'Dibatalkan' ? 'selected' : '' %>>Dibatalkan</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Poli</label>
                <select name="poli" class="form-control">
                    <option value="">Semua Poli</option>
                    <% Object.keys(daftarPoli).forEach(kode => { %>
                        <option value="<%= kode %>" <%= filter.poli === kode ? 'selected' : '' %>><%= daftarPoli[kode].label %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Terapkan Filter</button>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Nomor</th>
                        <th>Nama Pasien</th>
                        <th>Poli</th>
                        <th>Kategori</th>
                        <th>Tanggal</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (data.length === 0) { %>
                        <tr><td colspan="6" class="text-center text-muted py-4">Tidak ada data untuk filter ini 🌸</td></tr>
                    <% } %>
                    <% data.forEach(item => { %>
                    <tr>
                        <td><strong><%= item.nomor_antrean %></strong></td>
                        <td><%= item.nama %></td>
                        <td><%= daftarPoli[item.poli] ? daftarPoli[item.poli].label : item.poli %></td>
                        <td>
                            <span class="<%= item.kategori === 'prioritas' ? 'badge-prioritas' : 'badge-umum' %>">
                                <%= item.kategori === 'prioritas' ? 'Prioritas' : 'Umum' %>
                            </span>
                        </td>
                        <td><%= item.tanggal %></td>
                        <td>
                            <% if (item.status === 'Selesai') { %>
                                <span class="badge-status-selesai">Selesai</span>
                            <% } else if (item.status === 'Dipanggil') { %>
                                <span class="badge-status-dipanggil">Dipanggil</span>
                            <% } else if (item.status === 'Menunggu') { %>
                                <span class="badge-status-menunggu">Menunggu</span>
                            <% } else { %>
                                <span class="badge-status-batal"><%= item.status %></span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<%- include('partials/petals') %>

</body>
</html>
